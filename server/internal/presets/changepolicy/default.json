{
 "classes": {
  "network-change": ["\\bip\\s+(?:-\\S+\\s+)*(?:addr|address|a|link|l|route|r|ro|rule|neigh|n|tunnel|netns|vrf)\\s+(?:add|del|delete|change|replace|set|flush|append|prepend)\\b", "\\bbridge\\s+(?:link|fdb|vlan|mdb)\\s+(?:add|del|set|replace)\\b", "\\bbrctl\\s+(?:addbr|delbr|addif|delif|set\\w+)\\b", "\\bnft\\s+(?:-\\S+\\s+)*(?:add|delete|flush|insert|replace|create|destroy|-f)\\b", "\\b(?:ip6?|eb|arp)tables(?:-nft|-legacy)?(?:-restore\\b|\\s.*\\s-[AIDRFXNPZE]\\b)", "\\b(?:ifup|ifdown|ifreload)\\b|\\bnetplan\\s+(?:apply|try|set)\\b|\\bnmcli\\s.*\\b(?:up|down|modify|mod|add|delete|reload)\\b", "\\bsysctl\\s+(?:-w\\s+)?net\\.\\S+=|/proc/sys/net/", "\\bsystemctl\\s+(?:restart|stop|reload|disable|mask)\\s+(?:networking|systemd-networkd|NetworkManager|nftables|ssh|sshd|tailscaled)\\b", "\\bincus\\s+network\\s+(?:create|delete|edit|set|unset|attach|detach)\\b", "\\bipmitool\\s.*\\blan\\s+set\\b", "(?:>|\\btee\\b|\\bsed\\s+-i|\\bmv\\b|\\bcp\\b|\\brm\\b|\\bln\\b|\\binstall\\b|\\btruncate\\b)[^;&|]*/etc/(?:network|netplan|systemd/network|NetworkManager|nftables)", "^/etc/(?:network|netplan|systemd/network|NetworkManager|nftables)"],
  "system-change": ["\\bsystemctl\\s+(?:restart|stop|start|enable|disable|mask|reload)\\b", "\\bapt(?:-get)?\\s+(?:install|remove|purge|upgrade|dist-upgrade)\\b", "\\bincus\\s+(?:launch|delete|stop|restart|config\\s+set|storage\\s+(?:create|delete))\\b", "\\bzfs\\s+(?:destroy|rollback|create|set)\\b|\\bzpool\\s+(?:create|destroy|add|remove)\\b", "\\b(?:useradd|userdel|usermod|passwd|visudo)\\b", "(?:>|\\btee\\b|\\bsed\\s+-i|\\bmv\\b|\\bcp\\b|\\brm\\b)[^;&|]*\\s/etc/", "^/etc/"],
  "remote-exec": ["\\b(?:ssh|scp|rsync|sftp|ansible|ansible-playbook|incus\\s+exec)\\b"],
  "guardrail-tamper": ["(?:>|\\btee\\b|\\bsed\\s+-i|\\brm\\b|\\bmv\\b|\\bcp\\b|\\bchmod\\b|\\bchown\\b|\\btruncate\\b)[^;&|]*(?:/etc/gold-(?:policy|change)|/var/lib/gold-(?:policy|change)|/srv/gold-change/approvals|\\.claude/settings|\\.codex/(?:hooks|config|rules))"]
 },
 "regions": [
  {"code": "WI", "name": "Wisconsin", "hosts": ["wi-*", "*-wi-*", "*.wi.*", "wi-infra-dev*"]},
  {"code": "TX", "name": "Texas", "hosts": ["tx-*", "*-tx-*", "*.tx.*"]},
  {"code": "VA", "name": "Virginia", "hosts": ["va-*", "*-va-*", "*.va.*"]}
 ],
 "rules": [
  {"id": "geo-block-wi-tx-va", "name": "Geographic block: Wisconsin, Texas, Virginia", "hook": "geographic-block", "enabled": true, "priority": 100, "effect": "require", "when": {"tools": ["*"], "regions": ["WI", "TX", "VA"]}, "require": [{"check": "ticket"}, {"check": "approval", "msg": "WI/TX/VA need Jesse's approval (a human PASS on the ticket)"}], "message": "Nothing touches Wisconsin, Texas or Virginia without an approved ticket."},
  {"id": "guardrail-tamper", "name": "Guardrail files are not agent-writable", "hook": "self-protection", "enabled": true, "priority": 95, "effect": "deny", "when": {"tools": ["*"], "classes": ["guardrail-tamper"]}, "message": "Policy, approval and hook config files can only be changed by the approver (UI)."},
  {"id": "guardrail-tamper-files", "name": "File tools can't edit guardrail files", "hook": "self-protection", "enabled": true, "priority": 95, "effect": "deny", "when": {"tools": ["Write", "Edit", "MultiEdit", "NotebookEdit", "apply_patch", "hub:fs.write"], "command_re": "(?:/etc/gold-(?:policy|change)|/var/lib/gold-(?:policy|change)|/srv/gold-change/approvals|\\.claude/settings|\\.codex/(?:hooks|config|rules))"}, "message": "Policy, approval and hook config files can only be changed by the approver (UI)."},
  {"id": "destructive-root-delete", "name": "No recursive delete of / or home roots", "hook": "self-protection", "enabled": true, "priority": 96, "effect": "deny", "when": {"tools": ["*"], "command_re": "\\brm\\s+(?:-[a-zA-Z]*[rR][a-zA-Z]*\\s+)+(?:--no-preserve-root\\s+)?(?:/|/\\*|~|/home|/root|/etc)(?:\\s|$)"}, "message": "Recursive deletes of /, /etc, /home, /root or ~ are never allowed through the hub."},
  {"id": "infra-change-review", "name": "Infra change needs a reviewed ticket", "hook": "review", "enabled": true, "priority": 85, "effect": "require", "when": {"tools": ["*"], "classes": ["network-change", "system-change"]}, "require": [{"check": "ticket"}, {"check": "field", "field": "topology", "min_len": 10}, {"check": "field", "field": "blast_radius", "min_len": 20}, {"check": "list", "field": "research", "pattern": "^(?:https?://\\S+|/\\S+)", "file_exists": true, "msg": "list 'research' needs a source URL or an evidence path"}, {"check": "list", "field": "verification", "msg": "list 'verification' needs at least one check"}, {"check": "review", "min": 1, "role": "reviewer", "msg": "a reviewer agent or human must PASS this ticket"}], "message": "Infra changes need a ticket with topology, blast radius, research and verification, and a PASS from a reviewer who is not the author."},
  {"id": "pre-change-snapshot", "name": "Snapshot, topology and blast radius before a change", "hook": "pre-change-snapshot", "enabled": true, "priority": 75, "effect": "require", "when": {"tools": ["*"], "classes": ["network-change", "system-change"]}, "require": [{"check": "field", "field": "snapshot", "file_exists": true, "max_age_s": 3600, "contains_id": true, "msg": "field 'snapshot' must name evidence attached to the ticket (ticket_evidence_add kind=snapshot), under an hour old, mentioning the ticket id"}], "message": "Attach a fresh pre-change snapshot as ticket evidence."},
  {"id": "network-commit-confirm", "name": "Network change: auto-revert timer + verified out-of-band path", "hook": "commit-confirm", "enabled": true, "priority": 70, "effect": "require", "when": {"tools": ["*"], "classes": ["network-change"]}, "require": [{"check": "via_runner"}, {"check": "number", "field": "revert_after_s", "min": 10, "max": 300, "msg": "field 'revert_after_s' (auto-revert timer, 10-300 s) is required"}, {"check": "field", "field": "oob_path", "not": "(?i)^none", "min_len": 5, "msg": "field 'oob_path' must name a real out-of-band path"}, {"check": "list", "field": "oob_check", "msg": "list 'oob_check' needs a command that proves the out-of-band path works"}], "params": {"max_revert_s": 300}, "message": "Network changes run only through gold-policy run on the host (commit-confirm with auto-revert); the hub never runs them directly."},
  {"id": "network-change-approval", "name": "Network change needs approval", "hook": "approval", "enabled": true, "priority": 65, "effect": "require", "when": {"tools": ["*"], "classes": ["network-change"]}, "require": [{"check": "approval"}], "message": "The approver must sign this exact ticket version."},
  {"id": "failure-evidence", "name": "On failure: collect evidence", "hook": "failure-trigger", "enabled": true, "priority": 10, "effect": "collect", "when": {"events": ["post-failure"], "tools": ["*"]}, "collect": ["date -Is", "ip -br addr", "ip -br link", "ip route show table all", "ip rule", "bridge link"], "message": "A failed tool call or change saves network state as evidence."}
 ]
}
